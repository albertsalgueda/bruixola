{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run --filter '@bruixola/web' build",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "installCommand": "bun install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://bruixola.fly.dev/$1"
    }
  ]
}
