# ─────────────────────────────────────────────────────────────
# Bruixola — environment variables (template)
# Copy to .env and fill in. .env is gitignored.
# In production, set these via Fly secrets:
#   fly secrets set KEY=value
# ─────────────────────────────────────────────────────────────

# API server
PORT=3001
NODE_ENV=development

# CORS — comma-separated list of allowed origins. Use * only in dev.
CORS_ORIGIN=http://localhost:5173

# API auth — bearer token clients must send in Authorization header.
# Generate locally: openssl rand -hex 32
# Production: set via fly secrets, never commit.
BRUIXOLA_API_TOKEN=replace-with-32-byte-hex-token

# DuckDB — path to the local DuckDB file. Built from CSVs by the scraper pipeline.
DUCKDB_PATH=./data/db/intel.duckdb

# Mapbox — frontend map. Get a token at https://account.mapbox.com/access-tokens/
# Free tier covers 50,000 map loads/mo. Lock the token to your domain in Mapbox dashboard.
VITE_MAPBOX_TOKEN=pk.replace-with-mapbox-public-token

# Generalitat / Catalonia open data
# Índex de referència de preus de lloguer (SERPAVI) — used by yield_calc.
# Free, no key required. URL is the published dataset.
GENERALITAT_RENT_INDEX_URL=https://habitatge.gencat.cat/...

# HUT (Habitatges d'Ús Turístic) registry endpoint
# Free, no key required.
HUT_REGISTRY_URL=https://registreturisme.gencat.cat/...

# Telegram Bot — get a token from @BotFather. Free.
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_BOT_USERNAME=bruixola_bot

# OpenClaw — config path (the real config with secrets, gitignored)
# Generated from openclaw/config.yaml.template by bootstrap.sh
OPENCLAW_CONFIG_PATH=./openclaw/config.yaml

# Anthropic — used INDIRECTLY by OpenClaw for the agent. Do NOT import Anthropic
# SDK in app code. OpenClaw owns this key.
ANTHROPIC_API_KEY=sk-ant-replace

# Tigris S3 (image storage at scale, free tier ~5GB)
TIGRIS_ACCESS_KEY_ID=replace
TIGRIS_SECRET_ACCESS_KEY=replace
TIGRIS_BUCKET=bruixola-images
TIGRIS_ENDPOINT=https://fly.storage.tigris.dev

# Nominatim (geocoding) — free OSM endpoint. Required UA per OSM policy.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=bruixola-scraper/0.1 (+https://bruixola.cat/scraper-info)

# OSRM (routing) — local containerized instance for walk/drive times
OSRM_URL=http://localhost:5000

# ─── Next.js (apps/web — these MUST be NEXT_PUBLIC_* to expose to the browser) ───
# Same Supabase URL as above, but the Next.js convention is to prefix with NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_URL=https://yqivzzrdhevdmngwglmw.supabase.co
# Publishable (anon) key — safe to ship to browser, RLS gates writes.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_pITqd_jQS4sEgFwIy342cA_q77kLdJ2
# Mapbox public token (optional — when set, the COP map uses Mapbox dark style.
# When unset, falls back to MapLibre + Carto Dark Matter (free, no token, equally good for dev).
NEXT_PUBLIC_MAPBOX_TOKEN=
