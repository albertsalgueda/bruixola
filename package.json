{
  "name": "bruixola",
  "version": "0.1.0",
  "private": true,
  "description": "Bruixola — real-estate intelligence · Catalonia",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/shared"
  ],
  "scripts": {
    "dev": "bun --filter '@bruixola/web' dev",
    "build": "bun --filter '@bruixola/web' build",
    "test:e2e": "bun --filter '@bruixola/web' test:e2e",
    "lint": "bun --filter '@bruixola/web' lint",
    "typecheck": "bun --filter '@bruixola/web' typecheck",
    "schema:gen": "bun run packages/shared/scripts/codegen-zod.ts && bash packages/shared/scripts/codegen-pydantic.sh",
    "schema:verify": "bash packages/shared/scripts/verify-no-drift.sh"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1.30"
  }
}
